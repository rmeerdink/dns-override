#!/usr/bin/env bash
set -euo pipefail

PIDFILE=/var/vcap/sys/run/dns-override/pid
LOGDIR=/var/vcap/sys/log/dns-override
ETC_RESOLV=/etc/resolv.conf

mkdir -p "$(dirname "$PIDFILE")" "$LOGDIR"

cat > "$ETC_RESOLV" <<EOF
<% p('dns.servers').each do |s| -%>
nameserver <%= s %>
<% end -%>
search <%= p('dns.search').join(' ') %>
EOF

echo $$ > "$PIDFILE"

# Stay alive so monit is happy
while true; do
  sleep 300
done

